{
  "crons": [
    { "path": "/api/google/auto-reply", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/.well-known/mcp/server-card.json",
      "destination": "/api/mcp-server-card"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/awara-hostels.md"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </awara-hostels.md>; rel=\"alternate\"; type=\"text/markdown\""
        },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/awara-hostels.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/api/mcp-server-card",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ]
}
