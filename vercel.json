{
  "crons": [
    { "path": "/api/google/auto-reply", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/awara-hostels.md"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </awara-hostels.md>; rel=\"alternate\"; type=\"text/markdown\""
        },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/awara-hostels.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
